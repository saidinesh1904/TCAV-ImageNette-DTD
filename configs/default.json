{
  "seed": 42,
  "data_dir": "tcav_data",
  "out_dir": "tcav_outputs",
  "imagenette_url": "https://s3.amazonaws.com/fast-ai-imageclas/imagenette2-320.tgz",
  "dtd_url": "https://www.robots.ox.ac.uk/~vgg/data/dtd/download/dtd-r1.0.1.tar.gz",
  "val_fraction": 0.1,
  "resize": 256,
  "img_size": 224,
  "mean": [0.485, 0.456, 0.406],
  "std": [0.229, 0.224, 0.225],
  "batch_size": 64,
  "num_workers": 2,
  "epochs": 6,
  "lr": 0.0001,
  "weight_decay": 0.0001,
  "label_smoothing": 0.0,
  "patience": 3,
  "use_amp": true,
  "force_retrain": false,
  "pilot": false,
  "concepts": ["dotted", "striped", "banded", "zigzagged", "woven"],
  "concept_class_hypotheses": {
    "dotted": "golf ball",
    "striped": "English springer",
    "banded": "parachute",
    "zigzagged": "chain saw",
    "woven": "cassette player"
  },
  "n_concept_imgs": 120,
  "reference_source": "dtd_other",
  "ref_pool_size": 1500,
  "extra_exclude": ["polka-dotted", "lined", "stratified", "crosshatched"],
  "tcav_layers": ["layer4", "layer3"],
  "primary_layer": "layer3",
  "tcav_batch_size": 64,
  "tcav_only_correct": false,
  "cav_val_frac": 0.2,
  "cav_steps": 200,
  "cav_lr": 0.02,
  "cav_l2": 0.01,
  "cav_min_acc": 0.7,
  "n_cav_runs": 30,
  "n_random_runs": 50,
  "controls": ["shuffled_labels", "random_reference"],
  "alpha": 0.05,
  "pilot_epochs": 2,
  "pilot_cav_runs": 5,
  "pilot_random_runs": 10
}
